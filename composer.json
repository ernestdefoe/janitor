{
  "name": "ernestdefoe/janitor",
  "description": "Janitor for Flarum 2 — automated, rules-based discussion housekeeping. Define rules that periodically find discussions in chosen tags matching conditions (age, tags, reply count) and hide, lock, retag/move, or delete them. Scheduler-driven, with a global dry-run, per-run caps, and an action log.",
  "keywords": [
    "flarum",
    "flarum-extension",
    "moderation",
    "automation",
    "cleanup",
    "archive",
    "scheduler"
  ],
  "type": "flarum-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "ernestdefoe",
      "email": "ernestdefoe@gmail.com"
    }
  ],
  "homepage": "https://github.com/ernestdefoe/janitor",
  "support": {
    "forum": "https://discuss.flarum.org/d/39491-janitor-built-with-ai",
    "issues": "https://github.com/ernestdefoe/janitor/issues",
    "source": "https://github.com/ernestdefoe/janitor"
  },
  "require": {
    "php": "^8.3",
    "flarum/core": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "ErnestDefoe\\Janitor\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ErnestDefoe\\Janitor\\Tests\\": "tests/"
    }
  },
  "extra": {
    "flarum-extension": {
      "title": "Janitor",
      "category": "moderation",
      "icon": {
        "name": "fas fa-broom",
        "backgroundColor": "#3b8c5a",
        "color": "#fff"
      },
      "optional-dependencies": [
        "flarum/tags"
      ]
    },
    "flarum-cli": {
      "modules": {
        "js": true,
        "css": true,
        "locale": true
      }
    }
  },
  "require-dev": {
    "flarum/phpstan": "^2.0",
    "flarum/tags": "^2.0",
    "flarum/testing": "^2.0"
  },
  "scripts": {
    "test": [
      "@test:integration"
    ],
    "test:integration": "phpunit -c tests/phpunit.integration.xml",
    "test:setup": "@php tests/integration/setup.php",
    "analyse:phpstan": "phpstan analyse"
  },
  "scripts-descriptions": {
    "test": "Runs all tests.",
    "test:integration": "Runs all integration tests.",
    "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
    "analyse:phpstan": "Run static analysis"
  },
  "minimum-stability": "beta",
  "prefer-stable": true
}
